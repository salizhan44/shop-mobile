EXPO_PUBLIC_API_URL=http://localhost:3000
# OAuth Web Client ID из Google Cloud Console (тип «Веб-приложение»)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# На iPhone без отдельного iOS ID приложение подставит Web Client ID.
# Для стабильного входа лучше создать OAuth client типа iOS / Android:
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
