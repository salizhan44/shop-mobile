EXPO_PUBLIC_API_URL=http://localhost:3000
# WhatsApp магазина (цифры с кодом страны, без +). «Забыли пароль» пишет сюда.
EXPO_PUBLIC_SHOP_WHATSAPP=996555123456
# OAuth Web Client ID из Google Cloud Console (тип «Веб-приложение»)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# На iPhone без отдельного iOS ID приложение подставит Web Client ID.
# Для стабильного входа лучше создать OAuth client типа iOS / Android:
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
